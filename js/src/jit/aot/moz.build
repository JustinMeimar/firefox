FINAL_LIBRARY = "js"

include("../../js-config.mozbuild")
include("../../js-cxxflags.mozbuild")

# The .S file needs the image sitting next to it at assemble time.
# Using a .inc suffix (rather than .bin) puts this GeneratedFile in
# mozbuild's pre-compile tier, so it exists before the .S is assembled.
GeneratedFile(
    "AOTImage.inc",
    script="GenerateEmptyAOTImage.py",
    inputs=[],
)

SOURCES += [
    "AOTImageIncbin.S",
]

# The assembler searches for the generated image relative to the object
# directory.
LOCAL_INCLUDES += ["!."]
