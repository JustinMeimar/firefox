// Matches the declaration order of the unary math function enum. An entry
// missing here makes recording crash on the unmapped pointer rather than
// silently binding to the wrong slot.
AOT_ABIFN(js::math_sin_native_impl)
AOT_ABIFN(js::math_sin_fdlibm_impl)
AOT_ABIFN(js::math_cos_native_impl)
AOT_ABIFN(js::math_cos_fdlibm_impl)
AOT_ABIFN(js::math_tan_native_impl)
AOT_ABIFN(js::math_tan_fdlibm_impl)
AOT_ABIFN(js::math_log_impl)
AOT_ABIFN(js::math_exp_impl)
AOT_ABIFN(js::math_acos_impl)
AOT_ABIFN(js::math_asin_impl)
AOT_ABIFN(js::math_atan_impl)
AOT_ABIFN(js::math_log10_impl)
AOT_ABIFN(js::math_log2_impl)
AOT_ABIFN(js::math_log1p_impl)
AOT_ABIFN(js::math_expm1_impl)
AOT_ABIFN(js::math_cosh_impl)
AOT_ABIFN(js::math_sinh_impl)
AOT_ABIFN(js::math_tanh_impl)
AOT_ABIFN(js::math_acosh_impl)
AOT_ABIFN(js::math_asinh_impl)
AOT_ABIFN(js::math_atanh_impl)
AOT_ABIFN(js::math_trunc_impl)
AOT_ABIFN(js::math_cbrt_impl)
AOT_ABIFN(js::math_floor_impl)
AOT_ABIFN(js::math_ceil_impl)
AOT_ABIFN(js::math_round_impl)

#define AOT_ABIFN_ATOMICS_GROUP(fn)                     \
  AOT_ABIFN_NOLINK(js::jit::fn(Scalar::Int8))           \
  AOT_ABIFN_NOLINK(js::jit::fn(Scalar::Uint8))          \
  AOT_ABIFN_NOLINK(js::jit::fn(Scalar::Int16))          \
  AOT_ABIFN_NOLINK(js::jit::fn(Scalar::Uint16))         \
  AOT_ABIFN_NOLINK(js::jit::fn(Scalar::Int32))          \
  AOT_ABIFN_NOLINK(js::jit::fn(Scalar::Uint32))
AOT_ABIFN_ATOMICS_GROUP(AtomicsCompareExchange)
AOT_ABIFN_ATOMICS_GROUP(AtomicsExchange)
AOT_ABIFN_ATOMICS_GROUP(AtomicsAdd)
AOT_ABIFN_ATOMICS_GROUP(AtomicsSub)
AOT_ABIFN_ATOMICS_GROUP(AtomicsAnd)
AOT_ABIFN_ATOMICS_GROUP(AtomicsOr)
AOT_ABIFN_ATOMICS_GROUP(AtomicsXor)
#undef AOT_ABIFN_ATOMICS_GROUP

AOT_ABIFN(js::ArrayConstructor)

#define AOT_ABIFN_TA_CTOR(_, T, N) \
  AOT_ABIFN_NOLINK(js::TypedArrayConstructorNative(Scalar::N))
JS_FOR_EACH_TYPED_ARRAY(AOT_ABIFN_TA_CTOR)
#undef AOT_ABIFN_TA_CTOR

